    "db:seed": "tsx modules/core/data/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@node-rs/argon2": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.35.0",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "otpauth": "^9.5.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
